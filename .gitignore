*.exe
*.pdb
# *.lib
# *.dll

# Runtime libraries copied next to the executable by first.jai
# Leading slash anchors to repo root so modules/ source files are not excluded
/SDL3.dll
/libSDL3.so.0
/libSDL3.0.dylib
/libtracy.dll
/libtracy.so

# Tracy LTCG / incremental link artifacts produced by rebuild_windows.bat
modules/tracy/windows/*.exp
modules/tracy/windows/*.iobj
modules/tracy/windows/*.ipdb

# Old SDL2 binaries no longer used
/SDL2.dll
/SDL2.lib

# Ignore the archives generated by the shipping build option
*.zip

# Ignore the autogenerated files created by the save buttons in the application
CHANGELOG.md
LOG.txt

# Ignore Prizm session persistence files
console_history.txt

# Ignore the shapes folder which should not be version controlled
shapes-novc/

# Ignore the old data folder
data/old

# Ignore the example files written by the c++ api test exe
api/cpp/*.obj
api/cpp/.vs/

# Ignore the windows icon file which is generated in first.jai
*.ico

# Ignore imgui ini files
imgui*.ini

# Ignore RemedyBG x64 debugger files
*.rdbg

# Ignore render doc files
*.cap

.build/
.vscode/
*.code-workspace
imgui.ini

debug.log

# SDL3 source build artifacts (can be deleted once linux/bin/x64/libSDL3.so.0 is committed)
support/

# Claude Code per-machine local settings (keep the shared .claude/settings.json tracked)
.claude/settings.local.json
spike/libSDL3.so.0
spike/spike
spike/.build/
